generator client {
  provider    = "prisma-client-js"
  output      = "../generated/prisma"
  engine_type = "binary"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

enum ServiceType {
  PICKUP
  ANTAR
}

enum OrderStatus {
  BARU
  DIPROSES
  SELESAI_PRODUKSI
  SELESAI
  DIBATALKAN
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  image       String
  features    String[] @default([])
  customNote  String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([published, sortOrder])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String
  price       Int?
  priceUnit   String?
  image       String
  tags        String[] @default([])
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, slug])
  @@index([productId, published, sortOrder])
  @@map("product_variants")
}

model Order {
  id             String      @id @default(cuid())
  code           String      @unique
  customerName   String
  phone          String
  address        String
  // Tanggal barang diambil / dikirim (pre-order). Disimpan sebagai DATE.
  scheduledAt    DateTime?   @db.Date
  serviceType    ServiceType @default(PICKUP)
  // Wajib diisi saat serviceType = ANTAR (divalidasi di orders/actions.ts).
  deliveryPoint  String?
  deliveryMapUrl String?
  // Bebas, tanpa tabel master: pilihan dibangun dari data pesanan lama.
  source         String?
  note           String?
  shippingCost   Int         @default(0)
  subtotal       Int         @default(0)
  total          Int         @default(0)
  status         OrderStatus @default(BARU)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items OrderItem[]
  productionTasks ProductionTask[]

  @@index([status, createdAt])
  @@index([source])
  @@map("orders")
}

model ProductionTask {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId     String          @unique
  orderItem       OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // Tanggal kerja (disalin dari order scheduledAt).
  scheduledAt     DateTime        @db.Date
  stage           ProductionStage @default(ANTRI)
  note            String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([scheduledAt, stage])
  @@map("production_tasks")
}

enum ProductionStage {
  ANTRI
  DISIAPKAN
  DIPRODUKSI
  DIKEMAS
  SIAP
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productionTask ProductionTask?

  // Relasi opsional: varian/produk boleh dihapus tanpa menghapus riwayat pesanan.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot saat pesanan dibuat: nama & harga di katalog bisa berubah.
  productName String
  variantName String
  unitPrice   Int?
  priceUnit   String?
  quantity    Int
  lineTotal   Int      @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([orderId, sortOrder])
  @@index([variantId])
  @@index([productId])
  @@map("order_items")
}
