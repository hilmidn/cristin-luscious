generator client {
  provider    = "prisma-client-js"
  output      = "../generated/prisma"
  engine_type = "binary"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiTokens ApiToken[]

  @@map("admin_users")
}

/// Token akses API mobile (Flutter): login email+password menukar kredensial
/// dengan token acak; DB hanya menyimpan hash SHA-256-nya.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  name       String    @default("mobile")
  lastUsedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_tokens")
}

enum ServiceType {
  PICKUP
  ANTAR
}

enum OrderStatus {
  BARU
  DIPROSES
  SELESAI_PRODUKSI
  SELESAI
  DIBATALKAN
}

/// Cara pemenuhan pesanan produk: PRE_ORDER dibuat setelah pesanan masuk,
/// READY dijual dari stok jadi yang tersedia hari ini.
///
/// DEPRECATED (plan 2026-11-21-dynamic-stock-preorder): mode statis produk
/// akan dihapus setelah kode baru sepenuhnya membaca ketersediaan dinamis
/// dari stok varian (expand-contract; jangan dipakai di kode baru).
enum FulfillmentMode {
  PRE_ORDER
  READY
}

/// Cara pemenuhan aktual satu item pesanan (snapshot saat nota dibuat):
/// STOCK dijual dari stok jadi, PRE_ORDER dibuat lewat produksi.
/// Nullable untuk data lama sebelum backfill selesai ditinjau.
enum FulfillmentType {
  STOCK
  PRE_ORDER
}

model Product {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  tagline         String
  description     String
  image           String
  features        String[]        @default([])
  customNote      String?
  published       Boolean         @default(true)
  fulfillmentMode FulfillmentMode @default(PRE_ORDER)
  // false = dipajang di katalog tapi tidak bisa dipesan online (disembunyikan
  // dari halaman /order) — mis. produk yang produksinya ditunda.
  orderable       Boolean         @default(true)
  sortOrder       Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants    ProductVariant[]
  orderItems  OrderItem[]
  recipeItems RecipeItem[]

  @@index([published, sortOrder])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String
  price       Int?
  priceUnit   String?
  image       String
  tags        String[] @default([])
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Cached jumlah stok jadi siap jual; ledger variant_stock_movements = riwayat.
  stockQty    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems     OrderItem[]
  recipeItems    RecipeItem[]
  stockMovements VariantStockMovement[]

  @@unique([productId, slug])
  @@index([productId, published, sortOrder])
  @@map("product_variants")
}

model Order {
  id             String      @id @default(cuid())
  code           String      @unique
  customerName   String
  phone          String
  address        String
  // Tanggal barang diambil / dikirim (pre-order). Disimpan sebagai DATE.
  scheduledAt    DateTime?   @db.Date
  serviceType    ServiceType @default(PICKUP)
  // Wajib diisi saat serviceType = ANTAR (divalidasi di orders/actions.ts).
  deliveryPoint  String?
  deliveryMapUrl String?
  // Bebas, tanpa tabel master: pilihan dibangun dari data pesanan lama.
  source         String?
  note           String?
  shippingCost   Int         @default(0)
  subtotal       Int         @default(0)
  total          Int         @default(0)
  status         OrderStatus @default(BARU)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items               OrderItem[]
  productionTasks     ProductionTask[]
  ingredientMovements IngredientMovement[]

  @@index([status, createdAt])
  @@index([source])
  @@map("orders")
}

model ProductionTask {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // Tanggal kerja (disalin dari order scheduledAt).
  scheduledAt DateTime        @db.Date
  stage       ProductionStage @default(ANTRI)
  note        String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([scheduledAt, stage])
  @@map("production_tasks")
}

enum ProductionStage {
  ANTRI
  DISIAPKAN
  DIPRODUKSI
  DIKEMAS
  SIAP
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productionTask ProductionTask?

  // Relasi opsional: varian/produk boleh dihapus tanpa menghapus riwayat pesanan.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot saat pesanan dibuat: nama & harga di katalog bisa berubah.
  productName String
  variantName String
  unitPrice   Int?
  priceUnit   String?
  quantity    Int
  lineTotal   Int      @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  // Snapshot cara pemenuhan item ini (Batch 1 plan dynamic-stock-preorder):
  // STOCK dipenuhi dari stok jadi, PRE_ORDER dibuat lewat produksi.
  // Nullable = data lama yang belum punya bukti task/movement (ditinjau via
  // scripts/audit-fulfillment.ts sebelum dibuat wajib).
  fulfillmentType FulfillmentType?

  @@index([orderId, sortOrder])
  @@index([variantId])
  @@index([productId])
  @@map("order_items")
}

model Ingredient {
  id          String   @id @default(cuid())
  name        String
  unit        String // "gram" | "ml" | "pcs" (bebas, master manual)
  stockQty    Float    @default(0)
  minStockQty Float    @default(0) // ambang alert stok rendah
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseItems PurchaseItem[]
  recipeItems   RecipeItem[]
  movements     IngredientMovement[]

  @@map("ingredients")
}

model PurchaseNote {
  id          String   @id @default(cuid())
  supplier    String?
  note        String?
  totalCost   Int      @default(0)
  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  items PurchaseItem[]

  @@index([purchasedAt])
  @@map("purchase_notes")
}

model PurchaseItem {
  id             String       @id @default(cuid())
  purchaseNoteId String
  purchaseNote   PurchaseNote @relation(fields: [purchaseNoteId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qty            Float
  unitCost       Int          @default(0)
  totalCost      Int          @default(0)

  @@index([purchaseNoteId])
  @@index([ingredientId])
  @@map("purchase_items")
}

model RecipeItem {
  id           String          @id @default(cuid())
  // BASE recipe: diisi productId (semua varian produk ini mewarisi)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  // TOPPING recipe: diisi variantId (khusus varian ini)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qtyPerUnit   Float // takaran per 1 pcs produk
  note         String?

  @@unique([productId, ingredientId])
  @@unique([variantId, ingredientId])
  @@index([productId])
  @@index([variantId])
  @@index([ingredientId])
  @@map("recipe_items")
}

enum IngredientMovementType {
  PURCHASE
  PRODUCTION_USE
  MANUAL_ADJUST
}

model IngredientMovement {
  id           String                 @id @default(cuid())
  ingredientId String
  ingredient   Ingredient             @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type         IngredientMovementType
  qty          Float // + masuk, - keluar
  orderId      String? // penyebab deduction (idempotency)
  order        Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime               @default(now())

  @@index([ingredientId, createdAt])
  @@index([orderId])
  @@map("ingredient_movements")
}

enum VariantStockMovementType {
  IN // restock / pengembalian pembatalan
  OUT // terpakai order (ambil hari ini)
  ADJUST // koreksi manual ke nilai tertentu
}

model VariantStockMovement {
  id          String                   @id @default(cuid())
  variantId   String
  variant     ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type        VariantStockMovementType
  qty         Int // selalu positif; arah ditentukan type
  // Penyebab movement (untuk delta saat order diedit & idempotensi).
  orderItemId String?
  note        String?
  createdAt   DateTime                 @default(now())

  @@index([variantId, createdAt])
  @@index([orderItemId])
  @@map("variant_stock_movements")
}
