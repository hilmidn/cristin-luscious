// Draft tambahan untuk prisma/schema.prisma — modul Produksi.
// Belum diterapkan; prasyarat: item pesanan punya id stabil (lihat plan).

enum ProductionStage {
  ANTRI
  DISIAPKAN
  DIPRODUKSI
  DIKEMAS
  SIAP
}

model ProductionTask {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String          @unique
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // Salinan tanggal ambil/kirim agar kalender tidak perlu join berlapis.
  scheduledAt DateTime        @db.Date
  stage       ProductionStage @default(ANTRI)
  note        String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([scheduledAt, stage])
  @@map("production_tasks")
}

